rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function myIC() { return request.auth.token.ic; }
    function canApprove() { return signedIn() && request.auth.token.canApprove == true; }
    function manageStaff() { return signedIn() && request.auth.token.manageStaff == true; }

    // hod_cawangan carries NO claim describing branch authority — the token holds
    // only ic/canApprove/manageStaff, and manageStaff is global, so it cannot say
    // "my branch only". So read the caller's own staff doc and compare branches,
    // exactly as the config/publicHolidays rule below does. Costs one document read
    // per HOD write; HOD saves are rare. A role change then takes effect on the next
    // write with nothing to re-provision, which matters because onStaffWrite is not
    // deployed.
    function selfStaff() {
      return get(/databases/$(database)/documents/staff/$(myIC())).data;
    }
    function isBranchHodOf(branch) {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(myIC()))
        && selfStaff().role == 'hod_cawangan'
        && selfStaff().branch == branch;
    }

    // Pre-login picker — readable by anyone (incl. anonymous bootstrap). Created and
    // removed only via the Admin SDK (provision-auth.js); staff may rename themselves.
    match /directory/{id} {
      allow read: if request.auth != null;
      // The login-screen name list. Staff may sync ONLY their own `name` here,
      // so a self-service rename doesn't leave a stale name at login. Everything
      // else (branch, inactive, creating/removing entries) stays Admin-SDK only.
      allow update: if signedIn() && myIC() == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 80;
      allow create, delete: if false;
    }

    // Account signup is created by not-yet-staff (anonymous allowed); managed by HR/Admin.
    match /registration_requests/{id} {
      allow read, update, delete: if manageStaff();
      allow create: if request.auth != null;
    }

    match /staff/{ic} {
      allow read: if signedIn();
      allow create, delete: if manageStaff();
      // Staff may edit their OWN contact details and name. `name` is here so staff
      // can fix the casing of their own name (records were a mix of CAPS and
      // lowercase); the app title-cases it on save. Role, branch, category,
      // entitlements and inactive stay HR-only.
      allow update: if manageStaff()
        || ( myIC() == ic
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['name', 'phone', 'email', 'address', 'photoUrl'])
             && request.resource.data.name is string
             && request.resource.data.name.size() >= 3
             && request.resource.data.name.size() <= 80 )
        // A HOD Cawangan maintains leave figures for their own branch. The field
        // allowlist IS the security boundary: `role` and `branch` are absent, so a
        // HOD cannot promote anyone, move staff between branches, deactivate an
        // account or reset a password. myIC() != ic keeps them out of their own
        // balance — HR still owns that.
        || ( isBranchHodOf(resource.data.branch)
             && myIC() != ic
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'ent_AL', 'ent_MC', 'ent_EL', 'ent_EL_EMG', 'ent_HL',
                  'ent_ML', 'ent_PL', 'ent_CF', 'ent_UP', 'ent_CME',
                  'al_used_pre', 'mc_used_pre', 'el_used_pre', 'cme_used_pre',
                  'al_used_sys_adj', 'mc_used_sys_adj', 'el_used_sys_adj', 'cme_used_sys_adj',
                  'al_pelarasan', 'mc_pelarasan', 'el_pelarasan', 'cme_pelarasan'
                ]) );
    }

    match /leaves/{id} {
      allow read: if signedIn();
      allow create: if canApprove()
        || ( signedIn()
             && request.resource.data.ic == myIC()
             && request.resource.data.status in ['PENDING', 'HOD APPROVED'] );
      allow update: if canApprove()
        || ( signedIn()
             && resource.data.ic == myIC()
             && request.resource.data.status == 'PENDING'
             && request.resource.data.ic == resource.data.ic
             && request.resource.data.name == resource.data.name
             && request.resource.data.branch == resource.data.branch
             && request.resource.data.type == resource.data.type
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['startDate', 'endDate', 'reason', 'days', 'status']) );
      allow delete: if canApprove();
    }

    match /branches/{id} {
      allow read: if signedIn();
      allow write: if manageStaff();
    }

    // config/rolePermissions is the root of trust for custom claims, so these
    // admin-config collections are restricted to manageStaff (super_admin/admin/hr)
    // — a mid-tier approver must NOT be able to escalate their own claims.
    match /config/{id}        { allow read: if signedIn(); allow write: if manageStaff(); }
    match /system_config/{id} { allow read: if signedIn(); allow write: if manageStaff(); }
    match /settings/{id}      { allow read: if signedIn(); allow write: if manageStaff(); }

    // Public holidays are the one exception to the manageStaff-only config rule.
    // The app lets a HOD Cawangan maintain their own state's holiday list
    // (main.js `canEditTerengganu`), but no custom claim describes that right —
    // the token carries only `ic`, `canApprove` and `manageStaff`. So the role is
    // read straight off the staff document: a role change then takes effect on the
    // next write with nothing to re-provision, which matters because onStaffWrite
    // is not deployed. Costs one document read per save; holidays change twice a
    // year. Grants are OR'd with the `config/{id}` rule above, so this widens
    // access to THIS document only and cannot reach config/rolePermissions.
    match /config/publicHolidays {
      allow read: if signedIn();
      allow write: if manageStaff()
        || ( signedIn()
             && exists(/databases/$(database)/documents/staff/$(myIC()))
             && get(/databases/$(database)/documents/staff/$(myIC())).data.role == 'hod_cawangan' );
    }

    match /sessions/{ic} {
      allow read: if signedIn();
      allow create, update: if signedIn() && myIC() == ic;
      allow delete: if signedIn();
    }

    match /notifications/{id}      { allow read, write: if signedIn(); }

    // OTP password-reset state — written/read only by the external (no-Blaze)
    // reset backend via the Admin SDK, which bypasses rules. Browsers (incl. the
    // pre-login bootstrap) must never read OTP hashes, so deny all client access.
    match /password_resets/{id} { allow read, write: if false; }

    match /audit_logs/{id} { allow read, create: if signedIn(); allow update: if false; allow delete: if manageStaff(); }
    match /wa_logs/{id}    { allow read, create: if signedIn(); allow update: if false; allow delete: if manageStaff(); }
  }
}
